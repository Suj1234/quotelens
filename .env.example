# QuoteLens environment (TRD §4). Copy to .env.local; never commit real values.

# Absolute URL of the deployment (links in emails, memo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Direct → Session pooler string. Only used by `npm run db:migrate`.
DATABASE_URL=
# Only if client-side reads are used (prefer server reads)
SUPABASE_ANON_KEY=

# Cookie signing for iron-session, at least 32 chars (openssl rand -base64 32)
SESSION_SECRET=

# Gemini
GEMINI_API_KEY=
# Verified model IDs recorded in DECISIONS.md (P0-T6)
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=

# Optional decision provider: if set, decision layer uses Jev via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# mock | gmail | resend — overridden by settings.email_mode
EMAIL_MODE=mock

# Gmail mode only — not used in this build (live Gmail is out of scope, DECISIONS 2026-09-24; see src/lib/email/gmail.ts)
GMAIL_USER=
# 16-char App Password (2-step verification required)
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_SMTP_HOST=smtp.gmail.com

# Resend mode (stubbed, not configured)
RESEND_API_KEY=

# Optional free FX endpoint; if absent use settings.fx_rates
FX_API_URL=

# Password for both seeded users (Sujit, Priya)
SEED_ADMIN_PASSWORD=
